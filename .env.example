# ==============================================================================
# SAHYADRUSHTI AI - Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application
APP_NAME="SAHYADRUSHTI AI"
APP_VERSION="2.1.0"
DEBUG=true

# Database (Default: SQLite in WAL mode; replace with postgresql://user:pass@host:5432/db)
DATABASE_URL="sqlite:///./sahyadrushti.db"

# CORS Allowed Origins (Comma-separated or * for development)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Authentication & Security (Phase 3)
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Open-Meteo & Weather Pipeline
OPENMETEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPENMETEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
WEATHER_FETCH_INTERVAL_MINUTES=30
WEATHER_CACHE_TTL_MINUTES=15
API_DECAY_FACTOR=0.88

# Pilot Region Center Coordinates (Lonavala/Khandala, Maharashtra)
PILOT_LAT=18.755
PILOT_LON=73.395

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_PUBLIC_POST="10/minute"
RATE_LIMIT_PREDICT="30/minute"

